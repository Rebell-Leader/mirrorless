<style>
  .panel-root {
    width: 640px;
    flex-direction: column;
    gap: 16px;
    padding-top: 20px;
    padding-bottom: 22px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .heading {
    color: #101820;
    font-size: 31px;
    font-weight: 700;
  }

  .heading:dark {
    color: #f2f8ff;
  }

  .body {
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .target {
    width: 100%;
    text-align: center;
    color: #144e43;
    font-size: 76px;
    font-weight: 700;
  }

  .target:dark {
    color: #a2f4df;
  }

  .prompt {
    width: 100%;
    text-align: center;
    color: #16202a;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.2;
  }

  .prompt:dark {
    color: #f2f8ff;
  }

  .caption {
    width: 100%;
    text-align: center;
    color: #435364;
    font-size: 21px;
    line-height: 1.22;
  }

  .caption:dark {
    color: #c5d0dc;
  }

  .status {
    width: 100%;
    text-align: center;
    color: #f2f8ff;
    font-size: 23px;
    font-weight: 600;
    line-height: 1.2;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 14px;
    background-color: #273644;
  }

  .bar-track {
    width: 100%;
    height: 7px;
    border-radius: 4px;
    background-color: #a9bdc9;
  }

  .bar-track:dark {
    background-color: #48596a;
  }

  .bar-fill {
    height: 7px;
    width: 0%;
    border-radius: 4px;
    background-color: #72ebca;
  }

  .buttons {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }

  .button {
    min-height: 49px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 18px;
    padding-right: 18px;
  }

  .primary {
    background-color: #a2f4df;
  }

  .label {
    font-size: 22px;
    font-weight: 600;
  }

  .primary-label {
    color: #142923;
  }

  .tools {
    flex-direction: column;
    gap: 16px;
  }
</style>
<Panel class="panel-root">
  <div class="header">
    <div id="stage-title" class="heading">Warmup</div>
    <Button id="btn-settings" class="button">
      <ButtonLabel id="btn-settings-label" class="label">Menu</ButtonLabel>
    </Button>
  </div>

  <div id="practice-body" class="body">
    <div id="trainer-letter" class="target">L</div>
    <div id="trainer-word-progress" class="prompt">Letter 1 of 3</div>
    <div id="trainer-shape" class="caption">Point your index finger up and your thumb out.</div>
    <div id="trainer-status" class="status">Raise your signing hand.</div>
    <div id="trainer-progress" class="bar-track">
      <div id="trainer-bar" class="bar-fill"></div>
    </div>
  </div>

  <div id="choice-row" class="buttons">
    <Button id="btn-choice-0" class="button">
      <ButtonLabel id="btn-choice-0-label" class="label">Compare and continue</ButtonLabel>
    </Button>
    <Button id="btn-choice-1" class="button">
      <ButtonLabel id="btn-choice-1-label" class="label">Try again</ButtonLabel>
    </Button>
    <Button id="btn-choice-2" class="button">
      <ButtonLabel id="btn-choice-2-label" class="label">Skip recording</ButtonLabel>
    </Button>
  </div>

  <div id="next-row" class="buttons">
    <Button id="btn-next" class="button primary">
      <ButtonLabel id="btn-next-label" class="label primary-label">Skip letter</ButtonLabel>
    </Button>
    <Button id="btn-read-replay" class="button">
      <ButtonLabel class="label">Play again</ButtonLabel>
    </Button>
    <Button id="btn-speed" class="button">
      <ButtonLabel id="btn-speed-label" class="label">Slow</ButtonLabel>
    </Button>
  </div>

  <div id="settings-panel" class="tools">
    <div class="buttons">
      <Button id="btn-mode-warmup" class="button"><ButtonLabel class="label">Warmup</ButtonLabel></Button>
      <Button id="btn-mode-words" class="button"><ButtonLabel class="label">Spell a name</ButtonLabel></Button>
      <Button id="btn-mode-replay" class="button"><ButtonLabel class="label">Reader view</ButtonLabel></Button>
      <Button id="btn-mode-reading" class="button"><ButtonLabel class="label">Read a word</ButtonLabel></Button>
    </div>
    <div class="buttons">
      <Button id="btn-trainer-hand" class="button"><ButtonLabel id="btn-trainer-hand-label" class="label">Right hand</ButtonLabel></Button>
      <Button id="btn-trainer-ghost" class="button"><ButtonLabel id="btn-trainer-ghost-label" class="label">Dim guide</ButtonLabel></Button>
      <Button id="btn-switch-word" class="button"><ButtonLabel class="label">Switch word</ButtonLabel></Button>
      <Button id="btn-trainer-recenter" class="button"><ButtonLabel class="label">Recenter</ButtonLabel></Button>
      <Button id="btn-trainer-exit" class="button"><ButtonLabel class="label">Exit practice</ButtonLabel></Button>
    </div>
  </div>
</Panel>

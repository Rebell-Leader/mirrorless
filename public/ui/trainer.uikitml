<!--
  Mirrorless in-headset ASL fingerspelling trainer panel.
  Updated at runtime by TrainerSystem via setProperties.
  Uses plain ASCII punctuation and explicit light/dark color pairs.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 720px;
  }

  .header-band {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    padding-bottom: 12px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: #0b6b5a;
    border-radius: 12px;
    margin-top: 14px;
    margin-left: 20px;
    margin-right: 20px;
  }

  .stage-title {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .streak-badge {
    color: #d1fae5;
    font-size: 16px;
    font-weight: 700;
  }

  .content {
    flex-direction: column;
    gap: 10px;
    padding-top: 12px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 8px;
  }

  .prompt-row {
    flex-direction: row;
    gap: 20px;
    align-items: center;
  }

  .target-letter {
    width: 140px;
    color: #1c1d20;
    font-size: 108px;
    font-weight: 700;
    text-align: center;
  }

  .target-letter:dark {
    color: #fafaf7;
  }

  .prompt-col {
    flex-direction: column;
    gap: 6px;
    flex-grow: 1;
    flex-shrink: 1;
    width: 510px;
  }

  .word-progress {
    color: #0b6b5a;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .word-progress:dark {
    color: #3ee6c1;
  }

  .shape-desc {
    color: #1c1d20;
    font-size: 22px;
    line-height: 1.3;
  }

  .shape-desc:dark {
    color: #f0f1f3;
  }

  .meta-line {
    color: #55575d;
    font-size: 16px;
  }

  .meta-line:dark {
    color: #a7abb2;
  }

  .status-banner {
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 14px;
    background-color: #3a3d44;
    color: #ffffff;
    font-size: 24px;
    font-weight: 700;
  }

  .bar-track {
    height: 14px;
    border-radius: 7px;
    background-color: #d5d8dd;
  }

  .bar-track:dark {
    background-color: #2b2e34;
  }

  .bar-fill {
    height: 14px;
    width: 0%;
    border-radius: 7px;
    background-color: #18e08a;
  }

  .finger-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .finger-text {
    color: #374151;
    font-size: 16px;
    font-weight: 700;
  }

  .finger-text:dark {
    color: #d1d5db;
  }

  .choice-row {
    flex-direction: row;
    gap: 12px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 4px;
    padding-bottom: 4px;
  }

  .choice-btn {
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .choice-label {
    font-size: 22px;
    font-weight: 700;
  }

  .controls-row {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 6px;
    padding-bottom: 8px;
  }

  .ctrl-btn {
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .ctrl-label {
    font-size: 19px;
  }

  .scope-footer {
    color: #55575d;
    font-size: 14px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 16px;
  }

  .scope-footer:dark {
    color: #9ca3af;
  }
</style>
<Panel class="panel-root">
  <div id="stage-band" class="header-band">
    <div id="stage-title" class="stage-title">STAGE 1 OF 4: GHOST HAND WARMUP (L - B - Y)</div>
    <div id="streak-badge" class="streak-badge">Streak: 1d | 0/26 letters</div>
  </div>
  <div class="content">
    <div class="prompt-row">
      <div id="trainer-letter" class="target-letter">L</div>
      <div class="prompt-col">
        <div id="trainer-word-progress" class="word-progress">WARMUP: [L] - B - Y</div>
        <div id="trainer-shape" class="shape-desc">Index finger straight up and thumb straight out: an L; other fingers closed</div>
        <div id="trainer-meta" class="meta-line">Palm forward | Auto-graded (high tracker reliability)</div>
      </div>
    </div>
    <div id="trainer-status" class="status-banner">Match your hand to the 3D Ghost Hand on your wrist</div>
    <div class="bar-track">
      <div id="trainer-bar" class="bar-fill"></div>
    </div>
    <div class="finger-row">
      <div id="trainer-fingers" class="finger-text">Fingers: align with the glowing 3D Ghost Hand</div>
      <div id="trainer-table-status" class="meta-line">Table: ready</div>
    </div>
  </div>
  <div id="choice-row" class="choice-row">
    <Button id="btn-choice-0" class="choice-btn">
      <ButtonLabel id="btn-choice-0-label" class="choice-label">Self-Check Match</ButtonLabel>
    </Button>
    <Button id="btn-choice-1" class="choice-btn">
      <ButtonLabel id="btn-choice-1-label" class="choice-label">Option B</ButtonLabel>
    </Button>
    <Button id="btn-choice-2" class="choice-btn">
      <ButtonLabel id="btn-choice-2-label" class="choice-label">Option C</ButtonLabel>
    </Button>
  </div>
  <div class="controls-row">
    <Button id="btn-mode-warmup" class="ctrl-btn">
      <ButtonLabel class="ctrl-label">1. Warmup</ButtonLabel>
    </Button>
    <Button id="btn-mode-words" class="ctrl-btn">
      <ButtonLabel class="ctrl-label">2. My Name</ButtonLabel>
    </Button>
    <Button id="btn-mode-replay" class="ctrl-btn">
      <ButtonLabel class="ctrl-label">3. Reader View</ButtonLabel>
    </Button>
    <Button id="btn-mode-reading" class="ctrl-btn">
      <ButtonLabel class="ctrl-label">4. Read Table</ButtonLabel>
    </Button>
    <Button id="btn-next" class="ctrl-btn">
      <ButtonLabel id="btn-next-label" class="ctrl-label">Next Letter</ButtonLabel>
    </Button>
    <Button id="btn-speed" class="ctrl-btn">
      <ButtonLabel id="btn-speed-label" class="ctrl-label">Speed: Slow</ButtonLabel>
    </Button>
    <Button id="btn-trainer-hand" class="ctrl-btn">
      <ButtonLabel id="btn-trainer-hand-label" class="ctrl-label">Hand: right</ButtonLabel>
    </Button>
    <Button id="btn-trainer-recenter" class="ctrl-btn">
      <ButtonLabel class="ctrl-label">Recenter</ButtonLabel>
    </Button>
    <Button id="btn-trainer-exit" class="ctrl-btn">
      <ButtonLabel class="ctrl-label">Exit XR</ButtonLabel>
    </Button>
  </div>
  <div id="trainer-scope" class="scope-footer">ASL fingerspelling practice only (not ASL, not a translator, not medical access). Tutor hand is synthetic.</div>
</Panel>

<!--
  Headset letter recorder. RecorderSystem updates the ids at runtime:
  letter, shape, meta, take, status (text + background), hold-bar (width),
  saved, connection. Buttons are pressed with the non-recording hand.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 660px;
  }

  .content {
    flex-direction: column;
    gap: 10px;
    padding-top: 18px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 8px;
  }

  .eyebrow {
    color: #0b6b5a;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #3ee6c1;
  }

  .row {
    flex-direction: row;
    gap: 22px;
    align-items: center;
  }

  .letter {
    width: 130px;
    color: #1c1d20;
    font-size: 120px;
    font-weight: 700;
    text-align: center;
  }

  .letter:dark {
    color: #fafaf7;
  }

  .col {
    flex-direction: column;
    gap: 6px;
    flex-grow: 1;
    flex-shrink: 1;
    width: 460px;
  }

  .shape {
    color: #1c1d20;
    font-size: 24px;
    line-height: 1.3;
  }

  .shape:dark {
    color: #f0f1f3;
  }

  .meta {
    color: #55575d;
    font-size: 17px;
  }

  .meta:dark {
    color: #a7abb2;
  }

  .status {
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 14px;
    background-color: #3a3d44;
    color: #ffffff;
    font-size: 26px;
    font-weight: 700;
  }

  .bar-track {
    height: 14px;
    border-radius: 7px;
    background-color: #d5d8dd;
  }

  .bar-track:dark {
    background-color: #2b2e34;
  }

  .bar-fill {
    height: 14px;
    width: 0%;
    border-radius: 7px;
    background-color: #3ee6c1;
  }

  .small {
    color: #55575d;
    font-size: 16px;
  }

  .small:dark {
    color: #a7abb2;
  }

  .btn {
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .btn-label {
    font-size: 24px;
  }

  .buttons {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 12px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 20px;
    padding-top: 6px;
  }
</style>
<Panel class="panel-root">
  <div class="content">
    <div class="eyebrow">MIRRORLESS - LETTER RECORDER</div>
    <div class="row">
      <div id="letter" class="letter">A</div>
      <div class="col">
        <div id="shape" class="shape">Enter XR to start recording.</div>
        <div id="meta" class="meta">-</div>
        <div id="take" class="meta">-</div>
      </div>
    </div>
    <div id="status" class="status">Waiting for XR</div>
    <div class="bar-track">
      <div id="hold-bar" class="bar-fill"></div>
    </div>
    <div id="saved" class="small">No takes saved yet</div>
    <div id="connection" class="small">Checking connection to the laptop...</div>
  </div>
  <div class="buttons">
    <Button id="btn-redo" class="btn">
      <ButtonLabel class="btn-label">Redo last</ButtonLabel>
    </Button>
    <Button id="btn-skip" class="btn">
      <ButtonLabel class="btn-label">Skip letter</ButtonLabel>
    </Button>
    <Button id="btn-pause" class="btn">
      <ButtonLabel class="btn-label">Pause</ButtonLabel>
    </Button>
    <Button id="btn-hand" class="btn">
      <ButtonLabel id="btn-hand-label" class="btn-label">Hand: right</ButtonLabel>
    </Button>
    <Button id="btn-recenter" class="btn">
      <ButtonLabel class="btn-label">Recenter</ButtonLabel>
    </Button>
  </div>
</Panel>
